{
  "name": "@monitrail/checker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_SEND_METRICS=false wrangler dev --ip 127.0.0.1",
    "build": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist",
    "types": "WRANGLER_SEND_METRICS=false wrangler types",
    "lint": "biome lint . --error-on-warnings",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "vitest run",
    "test:runtime": "node scripts/verify-ssrf-runtime.mjs"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  }
}
