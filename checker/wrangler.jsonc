{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "monitrail-checker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "queues": {
    "producers": [{ "binding": "CHECK_TICKS", "queue": "monitrail-check-ticks" }],
    "consumers": [
      {
        "queue": "monitrail-check-ticks",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 0,
        "max_concurrency": 1
      }
    ]
  },
  "send_metrics": false
}
