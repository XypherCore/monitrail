{
  "name": "@monitrail/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 node scripts/next.mjs dev --webpack --hostname localhost",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "NEXT_TELEMETRY_DISABLED=1 node scripts/next.mjs start --hostname localhost",
    "lint": "biome lint . --error-on-warnings",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node ../node_modules/drizzle-kit/bin.cjs generate --config drizzle.rev2.config.ts",
    "db:migrate": "node --env-file-if-exists=.env.phase3b.local scripts/db/rev2.ts migrate",
    "db:seed": "node --env-file-if-exists=.env.phase3b.local scripts/db/rev2.ts seed --confirm-test-data",
    "db:verify-neon": "node --env-file-if-exists=.env.local scripts/db/verify-neon.ts",
    "auth:prepare": "node scripts/auth/setup-env.ts",
    "auth:verify-secrets": "node scripts/auth/verify-secrets.ts",
    "auth:verify-local": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.phase3b.local scripts/auth/verify-local.ts",
    "auth:verify-production": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.phase3b.local scripts/auth/verify-production.ts",
    "db:verify-postgres": "node --env-file-if-exists=.env.phase3b.local scripts/db/rev2.ts verify --confirm-clean-project",
    "db:prepare-production": "node --env-file=.env.production.local scripts/db/production.ts --confirm-fresh-production-project",
    "deploy:configure-production": "node scripts/deploy/configure-production.ts",
    "deploy:connect-services": "node scripts/deploy/connect-services.ts",
    "auth:invite": "node --env-file-if-exists=.env.phase3b.local scripts/auth/create-invite.ts --confirm-invite",
    "alerts:rotate-keys": "node scripts/alerts/rotate-channel-keys.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "postgres": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "lighthouse": "13.6.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3"
  }
}
