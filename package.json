{
  "name": "monitrail",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["web", "checker"],
  "engines": { "node": ">=24.12.0 <25", "npm": ">=11 <12" },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces && biome lint shared --error-on-warnings",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
